# -----------------------------------------------------------------------------
# Copy to apps/web/.env.local for local dev. On Vercel, set these in
# Project Settings -> Environment Variables.
# -----------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (`pnpm db:start` prints local values; hosted: Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 2: sending accounts ---------------------------------------------
# 32-byte key, base64. Generate: openssl rand -base64 32
# Rotation: add CREDENTIALS_ENCRYPTION_KEY_V2 and bump CREDENTIALS_ENCRYPTION_KEY_VERSION.
CREDENTIALS_ENCRYPTION_KEY=
CREDENTIALS_ENCRYPTION_KEY_VERSION=1
# Retired keys still needed to decrypt older rows, e.g.:
# CREDENTIALS_ENCRYPTION_KEY_V1=

# Local dev only (e.g. Mailpit on localhost:1025/1143). Ignored when VERCEL_ENV=production.
# Private/loopback mail hosts are otherwise blocked (SSRF protection), and
# credentials are never sent over a connection without TLS.
MAIL_ALLOW_PRIVATE_HOSTS=false
MAIL_ALLOW_PLAINTEXT_AUTH=false

# --- Background jobs (Inngest) --------------------------------------------------
# Local: run `pnpm inngest:dev` and set INNGEST_DEV=1 (no keys needed).
# Production: keys from the Inngest dashboard (or the Vercel integration).
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Sending ------------------------------------------------------------------
# Signs unsubscribe links. Generate: openssl rand -base64 32. Changing it breaks old links.
LINK_SIGNING_SECRET=
# Random gap between two sends from the same inbox (default 180–420 s = 3–7 min).
# Lower only for local testing.
# SEND_GAP_MIN_SECONDS=180
# SEND_GAP_MAX_SECONDS=420
# Warmup timing (defaults shown; shorten only for local testing)
# WARMUP_JITTER_SECONDS=540
# WARMUP_REPLY_DELAY_MIN_SECONDS=300
# WARMUP_REPLY_DELAY_MAX_SECONDS=2400

# --- Billing (Stripe, no SDK) ----------------------------------------------------
# Secret key: Stripe → Developers → API keys (sk_test_… while testing, sk_live_… later).
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<your-domain>/api/stripe/webhook (whsec_…).
STRIPE_WEBHOOK_SECRET=
# Price ids (price_…) of the four prices: Product catalog → product → price → copy id.
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Local tests only: a fake Stripe. Ignored when VERCEL_ENV=production.
# STRIPE_API_BASE=http://127.0.0.1:54398

# --- CRM (HubSpot) ---------------------------------------------------------------
# The access token is entered in Settings -> Integrations (stored encrypted).
# Local testing only: point the adapter at a fake HubSpot. Ignored when VERCEL_ENV=production.
# HUBSPOT_API_BASE=http://127.0.0.1:2590

# --- AI (Pro and trials) -----------------------------------------------------------
# Included AI runs on DeepSeek Flash with YOUR key (prepaid at platform.deepseek.com).
# Leave it empty to switch included AI off; workspaces can still add their own key.
DEEPSEEK_API_KEY=
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-flash
# Hidden monthly spend cap per workspace on included AI (customers never see it).
# AI_MONTHLY_CAP_GBP=2.50
# AI_TRIAL_CAP_GBP=0.25
# Cautious exchange rate used to turn the GBP cap into USD (DeepSeek bills in USD).
# AI_USD_PER_GBP=1.25
# Local testing only: let a workspace's own-key URL point at a local fake. Ignored in production.
# AI_ALLOW_PRIVATE_URLS=true
