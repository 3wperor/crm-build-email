# -----------------------------------------------------------------------------
# Copy to apps/web/.env.local for local dev. On Vercel, set these in
# Project Settings -> Environment Variables.
# -----------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (`pnpm db:start` prints local values; hosted: Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 2: sending accounts ---------------------------------------------
# 32-byte key, base64. Generate: openssl rand -base64 32
# Rotation: add CREDENTIALS_ENCRYPTION_KEY_V2 and bump CREDENTIALS_ENCRYPTION_KEY_VERSION.
CREDENTIALS_ENCRYPTION_KEY=
CREDENTIALS_ENCRYPTION_KEY_VERSION=1

# --- Phase 5: background jobs (Inngest) ---------------------------------------
# Not needed locally when running `npx inngest-cli dev`.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Phase 5/12: signed unsubscribe + tracking links ---------------------------
# Generate: openssl rand -base64 32
LINK_SIGNING_SECRET=

# --- Phase 7: optional AI reply classification --------------------------------
ANTHROPIC_API_KEY=
