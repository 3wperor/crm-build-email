{
  "name": "ycareach",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @crm/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > packages/db/src/database.types.ts",
    "db:test": "psql \"${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}\" -v ON_ERROR_STOP=1 -f supabase/tests/rls.sql",
    "inngest:dev": "npx --yes inngest-cli@1.45.1 dev -u http://localhost:3000/api/inngest",
    "activate-user": "node scripts/activate-user.mjs"
  },
  "devDependencies": {
    "supabase": "2.118.0",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "8.5.23",
      "source-map-js@<1.2.2": "1.2.2",
      "body-parser@>=2.0.0 <2.4.0": "2.4.0",
      "systeminformation@<5.33.16": "5.33.16",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "ip-address@>=10.0.0 <10.7.4": "10.7.4",
      "qs@>=6.0.0 <6.16.1": "6.16.1",
      "nodemailer@>=10.0.0 <10.1.4": "10.1.4"
    },
    "onlyBuiltDependencies": [
      "supabase",
      "esbuild",
      "sharp",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  }
}
